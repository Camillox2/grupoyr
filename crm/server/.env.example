# Neon PostgreSQL - use a pooled connection string for production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Required in production; never use the fallback value from source
JWT_SECRET=replace-with-a-long-random-secret

# Required only when creating the first local administrator in a new database
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional integrations
GEMINI_API_KEY=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=
# App Secret do app na Meta: com ele o webhook so aceita chamadas assinadas pela Meta
META_APP_SECRET=

# Blog do site. A Central editorial do CRM publica direto nas tabelas blog_posts
# do site quando alcanca esse banco. Se o CRM ja usa o MESMO banco do site em
# DATABASE_URL, nao precisa preencher: a ligacao e detectada sozinha.
BLOG_DATABASE_URL=

# Endereco publico do CRM (https). Usado no link de assinatura enviado ao cliente
PUBLIC_CRM_URL=

# Restrict browser access to the CRM frontend origin
CORS_ORIGIN=https://crm-app.grupoyrhospitalar.com.br
